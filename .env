# TENANCY (OPTIONAL)

#--------------------------------------------------------------------

# Tenant database naming prefix used during provisioning

# TENANT_DB_PREFIX = pos_tenant_

# Optional dedicated credentials for tenant databases (fallback to default DB creds)

# TENANT_DB_HOST = localhost

# TENANT_DB_PORT = 3306

# TENANT_DB_USER =

# TENANT_DB_PASS =

# Optional template database to clone when provisioning tenant DBs

# TENANT_DB_TEMPLATE =

# Separate app provisioning path and URL template for tenant slug apps

TENANT_APP_BASE_DIR = "D:/xampp/htdocs/kasbook"

TENANT_APP_URL_TEMPLATE = "http://localhost/kasbook/{slug}/"

# Tenant entry URL formats:

# Production: https://pos.khybersoft.com/{company}

# Localhost (under path): http://localhost/{path}/{company}

